# Backend settings. Copy this file to .env (git-ignored) and fill in the
# blanks. Only MONGO_URI and JWT_SECRET are needed to start; without the
# others, the checks they power answer "temporarily unavailable". Every
# setting with a value already has a working default.
# The frontend's settings are in frontend/.env.example.

# Database (MongoDB Atlas connection string)
MONGO_URI=
MONGO_DB_NAME=voiceguard

# Which websites may call the API
# Local development needs http://localhost:5173 here; production leaves it out
ALLOWED_ORIGINS=http://localhost:5173,https://voiceguard-nu.vercel.app

# Security events (backend/audit.py): kept this many days in the database.
# Also sent to PostHog when a project key is set; without one nothing is sent.
AUDIT_RETENTION_DAYS=30
POSTHOG_API_KEY=
# POSTHOG_HOST=https://us.i.posthog.com

# Interactive API docs at /docs, /redoc and /openapi.json. Off unless this is
# true; uncomment it locally. Never set it on the live server.
# DOCS_ENABLED=true
# Pause switches live in the database (backend/scripts/switch.py). These are
# backups: "false" forces that part off whatever the database says.
# SIGNUPS_ENABLED=true
# VOICE_CHECKS_ENABLED=true
# ENROLLMENT_ENABLED=true

# Sign-in: JWT_SECRET is any long random string
JWT_SECRET=
# Limited token (password only) lifetime; a voice-verified one lasts VERIFIED_TOKEN_MINUTES
JWT_EXPIRE_MINUTES=60
VERIFIED_TOKEN_MINUTES=15
# The sign-in cookie: set false only for local development in Safari (http)
# SESSION_COOKIE_SECURE=false
# Return the token in the response body too, until the frontend uses the cookie only
TOKEN_IN_RESPONSE_BODY=true
# 5 wrong passwords from one client lock that client out of the account;
# 20 from everyone together lock the account for everyone
LOGIN_MAX_FAILURES=5
LOGIN_ACCOUNT_MAX_FAILURES=20
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=1800
# Voice checks pause after this many rejections (the email code fallback, #20)
VOICE_MAX_FAILURES=3
VOICE_FAILURE_WINDOW_SECONDS=1800
VOICE_LOCKOUT_SECONDS=1800

# Where a client's address comes from, for per-client limits:
# cf-connecting-ip (live, behind Cloudflare), or peer (local). x-forwarded-for-last
# only if the live check shows that entry is the client, not a proxy.
CLIENT_IP_SOURCE=peer
# Per-client limits per hour (per-account ones are CHALLENGE/VERIFY/ENROLL_RATE_LIMIT)
SIGNUP_CLIENT_LIMIT=5
LOGIN_CLIENT_LIMIT=30
CHALLENGE_CLIENT_LIMIT=60
VERIFY_CLIENT_LIMIT=30
ENROLL_CLIENT_LIMIT=60
# Paid speech-to-text calls per day (UTC) from everyone together (voice checks and enrollment samples)
TRANSCRIPTION_DAILY_BUDGET=300

# Passages and the content check (OpenAI Whisper, paid per call)
CHALLENGE_TTL_SECONDS=120
WHISPER_MODEL=whisper-1
OPENAI_API_KEY=
CONTENT_MAX_MISSED_WORDS=1
CONTENT_MAX_EXTRA_WORDS=4

# Identity check and enrollment (the model service, see model-service/README.md)
EMBEDDING_SERVICE_URL=
EMBEDDING_SERVICE_TOKEN=
EMBEDDING_SERVICE_HF_TOKEN=
EMBEDDING_MODEL=speechbrain/spkrec-ecapa-voxceleb

# Email (Resend: resend.com/api-keys). EMAIL_FROM must be on a domain verified
# in Resend; for testing, onboarding@resend.dev only reaches your own address.
EMAIL_API_KEY=
EMAIL_FROM=
# Password reset (#109): the frontend page the emailed link opens (the token
# follows a "#"), how long a link works, and requests per address and from
# everyone per RATE_LIMIT_WINDOW_SECONDS.
PASSWORD_RESET_URL=https://voiceguard-nu.vercel.app/reset-password
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_EMAIL_LIMIT=3
PASSWORD_RESET_RATE_LIMIT=30
# Email verification at signup (#110). Leave false until the frontend's
# "check your email" screen is live and EMAIL_FROM is on a verified domain.
EMAIL_VERIFICATION_REQUIRED=false
EMAIL_CODE_MINUTES=15
EMAIL_CODE_MAX_TRIES=5
# Emails (codes and "you already have an account" notices) per address per
# RATE_LIMIT_WINDOW_SECONDS, the signup one included
EMAIL_CODE_SEND_LIMIT=5
# Code confirmations and new-code requests per client per window (#111)
EMAIL_CODE_CLIENT_LIMIT=30
# Accounts that never confirm are deleted after this many hours
UNVERIFIED_ACCOUNT_HOURS=24
VOICEPRINT_KEY=
IDENTITY_THRESHOLD=0.5
LIVENESS_THRESHOLD=0.0
# Say which check failed in voice-check answers (#112). Off unless this is
# true; uncomment it for demos or debugging. Never set it on the live server.
# The server log keeps the details either way.
# VERIFY_CHECK_DETAILS=true
ENROLL_SAMPLES_REQUIRED=3
ENROLL_MIN_SPEECH_SECONDS=1.5
ENROLL_MAX_CLIPPED_SHARE=0.01
ENROLL_CONSISTENCY_THRESHOLD=0.5
ENROLL_SESSION_TTL_SECONDS=1800

# Per-user limits on paid calls
RATE_LIMIT_WINDOW_SECONDS=3600
CHALLENGE_RATE_LIMIT=20
VERIFY_RATE_LIMIT=10
# Voice checks per account per day (UTC), so one account can't use most of the daily budget
VERIFY_DAILY_LIMIT=30
ENROLL_RATE_LIMIT=20
# Enrollment only in the signup session, this many minutes after the account
# was made. Accounts made before ENROLL_GRACE_UNTIL (UTC) may enroll after
# signing in until then; leave it empty for no grace period.
ENROLL_WINDOW_MINUTES=30
ENROLL_GRACE_UNTIL=2026-11-16T05:00:00Z
# New accounts per hour from everyone together (a backstop above the per-client limit)
SIGNUP_RATE_LIMIT=100
