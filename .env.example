# Backend settings. Copy this file to .env (git-ignored) and fill in the
# blanks. Only MONGO_URI and JWT_SECRET are needed to start; without the
# others, the checks they power answer "temporarily unavailable". Every
# setting with a value already has a working default.
# The frontend's settings are in frontend/.env.example.

# Database (MongoDB Atlas connection string)
MONGO_URI=
MONGO_DB_NAME=voiceguard

# Which websites may call the API
ALLOWED_ORIGINS=http://localhost:5173,https://voiceguard-nu.vercel.app

# Sign-in: JWT_SECRET is any long random string
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=1800
# Voice checks pause after this many rejections (the email code fallback, #20)
VOICE_MAX_FAILURES=3
VOICE_FAILURE_WINDOW_SECONDS=1800
VOICE_LOCKOUT_SECONDS=1800

# Passages and the content check (OpenAI Whisper, paid per call)
CHALLENGE_TTL_SECONDS=120
WHISPER_MODEL=whisper-1
OPENAI_API_KEY=
CONTENT_MAX_MISSED_WORDS=1
CONTENT_MAX_EXTRA_WORDS=4

# Identity check and enrollment (the model service, see model-service/README.md)
EMBEDDING_SERVICE_URL=
EMBEDDING_SERVICE_TOKEN=
EMBEDDING_SERVICE_HF_TOKEN=
EMBEDDING_MODEL=speechbrain/spkrec-ecapa-voxceleb
VOICEPRINT_KEY=
IDENTITY_THRESHOLD=0.5
LIVENESS_THRESHOLD=0.0
ENROLL_SAMPLES_REQUIRED=3
ENROLL_MIN_SPEECH_SECONDS=1.5
ENROLL_MAX_CLIPPED_SHARE=0.01
ENROLL_CONSISTENCY_THRESHOLD=0.5
ENROLL_SESSION_TTL_SECONDS=1800

# Per-user limits on paid calls
RATE_LIMIT_WINDOW_SECONDS=3600
CHALLENGE_RATE_LIMIT=20
VERIFY_RATE_LIMIT=10
ENROLL_RATE_LIMIT=20
SIGNUP_RATE_LIMIT=30
