# Frontend settings. Vite reads them from this folder, not the repository
# root. Copy this file to .env.local (git-ignored) to change them.

# The backend's address. Left unset, local development uses
# http://localhost:8000.
VITE_API_BASE_URL=http://localhost:8000

# PostHog browser analytics. Set these in .env or .env.local.
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://your-posthog-host
